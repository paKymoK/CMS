# OAuth2 (PKCE, public client — no secret) against auth-service's "cms-admin" client
VITE_AUTH_SERVER=http://localhost:9000
VITE_CLIENT_ID=cms-admin
VITE_REDIRECT_URI=http://localhost:5173/callback
VITE_SCOPES=openid profile offline_access
VITE_BASE_URL=http://localhost:8080

# Local-dev-only override for the Preview button — see AppShell.tsx's previewMutation. Leave
# unset in production/staging; the button falls back to the real per-site subdomain from
# config/sites.ts, which is what production actually needs.
# VITE_WEBSITE_ORIGIN=http://localhost:3000
