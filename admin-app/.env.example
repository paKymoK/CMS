# OAuth2 (PKCE, public client — no secret) against auth-service's "cms-admin" client
VITE_AUTH_SERVER=http://localhost:9000
VITE_CLIENT_ID=cms-admin
VITE_REDIRECT_URI=http://localhost:5173/callback
VITE_SCOPES=openid profile offline_access

# No gateway in this platform (see docs/cms-platform-plan.md's Phase 0 status) — admin-app
# calls each service's own port directly.
VITE_CONTENT_API_URL=http://localhost:8084
VITE_MEDIA_API_URL=http://localhost:8082
