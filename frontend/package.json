{
  "name": "cms-frontend",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm",
    "pnpm": ">=10"
  },
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.cjs",
    "dev:admin": "pnpm --filter cms-admin-app dev",
    "dev:website": "pnpm --filter landing-page dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint"
  }
}
