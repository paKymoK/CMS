# Base URL used for canonical/OG URLs and hreflang alternates.
# Set to the real staging hostname (behind the existing Cloudflare Tunnel) when
# deploying, so the PageSpeed comparison targets a real reachable URL.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_CMS_API_BASE_URL=http://localhost:8080

# LAN / test over plain HTTP:
# SITE_URL=http://<LAN-IP>:3000
# NEXT_PUBLIC_CMS_API_BASE_URL=http://<LAN-IP>:8080   # also drives the allowed next/image host
# ALLOWED_DEV_ORIGINS=<LAN-IP>                         # `next dev` only
