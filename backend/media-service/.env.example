# Copy to ".env" in this folder (gitignored) and uncomment/set only what needs to differ

# AUTH_ISSUER_URI=http://auth-service:9000   # local default (docker network name); production: auth-service PUBLIC URL (e.g. https://auth.example.com), identical in every service - it is the token "iss" and browsers are redirected to it
# DB_HOST=postgres              # production: localhost (native Postgres colocated on this VPS)
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres          # production: a real generated password, never the default
# EUREKA_INSTANCE_IP_ADDRESS=   # local: leave unset; production: THIS VPS's private IP (what the gateway uses to reach this service)
# EUREKA_URI=http://discovery-service:8761/eureka   # production: discovery-service VPS's private IP
# JWK_URI=http://auth-service:9000/oauth2/jwks       # production: auth-service VPS's private IP
# SPRING_DATA_REDIS_HOST=redis  # production: redis VPS's private IP (health check only, no real usage)
# SPRING_DATA_REDIS_PORT=6379
# MANAGEMENT_OTLP_TRACING_ENDPOINT=http://alloy:4318/v1/traces   # production: http://<this VPS's Alloy>:4318/v1/traces (Alloy runs on every VPS)

# --- LAN / test over plain HTTP: replace <LAN-IP> with this machine's address (same value everywhere) ---
# CORS_ALLOWED_ORIGINS=http://<LAN-IP>:5173,http://<LAN-IP>:3000   # admin + website origins
