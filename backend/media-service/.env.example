# Copy to ".env" in this folder (gitignored) and uncomment/set only what needs to differ

# AUTH_ISSUER_URI=http://127.0.0.1:9000          # production: auth-service VPS's private IP
# DB_HOST=127.0.0.1            # production: 127.0.0.1 if Postgres runs on this VPS, else its private IP (all services use host networking)
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres          # production: a real generated password, never the default
# EUREKA_INSTANCE_IP_ADDRESS=127.0.0.1   # production: THIS VPS's private IP (what the gateway uses to reach this service)
# EUREKA_URI=http://127.0.0.1:8761/eureka   # production: discovery-service VPS's private IP
# JWK_URI=http://127.0.0.1:9000/oauth2/jwks       # production: auth-service VPS's private IP
# SPRING_DATA_REDIS_HOST=127.0.0.1  # production: redis VPS's private IP (health check only, no real usage)
# SPRING_DATA_REDIS_PORT=6379
# MANAGEMENT_OTLP_TRACING_ENDPOINT=http://127.0.0.1:4318/v1/traces   # production: monitor VPS's private IP
