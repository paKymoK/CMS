# Copy to ".env" in this folder (gitignored) and uncomment/set only what needs to differ
#
# This same infrastructure/alloy/docker-compose.yml is deployed once per VPS (every
# app-service VPS + the redis VPS) — only LOKI_URL and PROMETHEUS_REMOTE_WRITE_URL ever
# need to change.

# LOKI_URL=http://loki:3100/loki/api/v1/push                  # production: monitor VPS's private IP
# PROMETHEUS_REMOTE_WRITE_URL=http://prometheus:9090/api/v1/write   # production: monitor VPS's private IP

# Status dashboard probes (website, admin app, database) - point at the real addresses in production
# PROBE_WEBSITE_URL=http://host.docker.internal:3000
# PROBE_ADMIN_URL=http://host.docker.internal:5173
# PROBE_DATABASE_ADDR=postgres:5432

