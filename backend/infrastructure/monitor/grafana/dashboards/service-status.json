{
  "title": "Service Status",
  "uid": "service-status",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "tags": [
    "status",
    "uptime"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Website & Admin",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (component) (probe_success{component=~\"website|admin\"}) or label_replace(vector(0), \"component\", \"website\", \"\", \"\") or label_replace(vector(0), \"component\", \"admin\", \"\", \"\")",
          "instant": true,
          "legendFormat": "{{component}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Database",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (component) (probe_success{component=\"database\"}) or label_replace(vector(0), \"component\", \"database\", \"\", \"\")",
          "instant": true,
          "legendFormat": "postgres",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Backend services",
      "description": "UP while the service has pushed metrics within the last 2 minutes. A service only appears after it has pushed once in the last 24h.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(min by (job) (time() - max_over_time(timestamp(process_uptime_seconds{job=~\".*-service\"})[24h:30s])) or label_replace(vector(86400), \"job\", \"discovery-service\", \"\", \"\") or label_replace(vector(86400), \"job\", \"auth-service\", \"\", \"\") or label_replace(vector(86400), \"job\", \"media-service\", \"\", \"\") or label_replace(vector(86400), \"job\", \"content-service\", \"\", \"\") or label_replace(vector(86400), \"job\", \"gateway-service\", \"\", \"\")) < bool 120",
          "instant": true,
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Uptime: Website, Admin & Database",
      "description": "Share of the selected time range the component was up (up samples / all expected samples). Missing data counts as down, so a component that was not reporting for part of the range lowers the figure.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 10,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(clamp_max(sum by (component) (sum_over_time(probe_success{component=~\"website|admin|database\"}[$__range])) * 15 / $__range_s, 1) * 100) or label_replace(vector(0), \"component\", \"website\", \"\", \"\") or label_replace(vector(0), \"component\", \"admin\", \"\", \"\") or label_replace(vector(0), \"component\", \"database\", \"\", \"\")",
          "instant": true,
          "legendFormat": "{{component}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Uptime: Backend services",
      "description": "Share of the selected time range the component was up (up samples / all expected samples). Missing data counts as down, so a component that was not reporting for part of the range lowers the figure.",
      "gridPos": {
        "x": 10,
        "y": 5,
        "w": 14,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(clamp_max(sum by (job) (count_over_time(process_uptime_seconds{job=~\".*-service\"}[$__range])) * 15 / $__range_s, 1) * 100) or label_replace(vector(0), \"job\", \"discovery-service\", \"\", \"\") or label_replace(vector(0), \"job\", \"auth-service\", \"\", \"\") or label_replace(vector(0), \"job\", \"media-service\", \"\", \"\") or label_replace(vector(0), \"job\", \"content-service\", \"\", \"\") or label_replace(vector(0), \"job\", \"gateway-service\", \"\", \"\")",
          "instant": true,
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "state-timeline",
      "title": "Status history",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (component) (probe_success{component=~\"website|admin|database\"}) or label_replace(vector(0), \"component\", \"website\", \"\", \"\") or label_replace(vector(0), \"component\", \"admin\", \"\", \"\") or label_replace(vector(0), \"component\", \"database\", \"\", \"\")",
          "legendFormat": "{{component}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(min by (job) (time() - max_over_time(timestamp(process_uptime_seconds{job=~\".*-service\"})[24h:30s])) or label_replace(vector(86400), \"job\", \"discovery-service\", \"\", \"\") or label_replace(vector(86400), \"job\", \"auth-service\", \"\", \"\") or label_replace(vector(86400), \"job\", \"media-service\", \"\", \"\") or label_replace(vector(86400), \"job\", \"content-service\", \"\", \"\") or label_replace(vector(86400), \"job\", \"gateway-service\", \"\", \"\")) < bool 120",
          "legendFormat": "{{job}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "center",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Probe response time",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (component) (probe_duration_seconds{component=~\"website|admin|database\"})",
          "legendFormat": "{{component}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
