# Copy to ".env" in this folder (gitignored) and uncomment/set only what needs to differ

# Only needed when Grafana is reached through a reverse proxy / tunnel (e.g. Cloudflare
# Tunnel) on a hostname other than localhost:3100
# Leaving these unset causes a CORS-looking failure in the browser.
# GF_SERVER_ROOT_URL=https://grafana.yourdomain.com/
# GF_SECURITY_CSRF_TRUSTED_ORIGINS=grafana.yourdomain.com

# Discord webhook for Grafana alerts (compose has a temporary test fallback)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
