# Copy to ".env" in this folder (gitignored) and uncomment/set only what needs to differ

# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_SCHEMA=content
# DB_USER=postgres
# DB_PASSWORD=postgres
# AUTH_ISSUER_URI=http://127.0.0.1:9000   # production: auth-service PUBLIC URL (e.g. https://auth.example.com), identical in every service
# JWK_URI=http://127.0.0.1:9000/oauth2/jwks
# EUREKA_INSTANCE_IP_ADDRESS=127.0.0.1   # production: THIS VPS's private IP (what the gateway uses to reach this service)
# EUREKA_URI=http://127.0.0.1:8761/eureka   # production: discovery-service VPS's private IP
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# MANAGEMENT_OTLP_TRACING_ENDPOINT=http://127.0.0.1:4318/v1/traces
