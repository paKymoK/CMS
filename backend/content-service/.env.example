# Copy to ".env" in this folder (gitignored) and uncomment/set only what needs to differ

# DB_HOST=postgres
# DB_PORT=5432
# DB_SCHEMA=content
# DB_USER=postgres
# DB_PASSWORD=postgres
# AUTH_ISSUER_URI=http://auth-service:9000   # local default (docker network name); production: auth-service PUBLIC URL (e.g. https://auth.example.com), identical in every service - it is the token "iss" and browsers are redirected to it
# JWK_URI=http://auth-service:9000/oauth2/jwks
# EUREKA_INSTANCE_IP_ADDRESS=   # local: leave unset; production: THIS VPS's private IP (what the gateway uses to reach this service)
# EUREKA_URI=http://discovery-service:8761/eureka   # production: discovery-service VPS's private IP
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000   # LAN test: http://<LAN-IP>:5173,http://<LAN-IP>:3000
# MANAGEMENT_OTLP_TRACING_ENDPOINT=http://alloy:4318/v1/traces
