# Copy to ".env" in this folder (gitignored) and uncomment/set only what needs to differ

# AUTH_ISSUER_URI=http://auth-service:9000          # default: docker network hostname; production: auth-service VPS's private IP
# DB_HOST=postgres              # production: localhost (native Postgres colocated on this VPS)
# DB_PORT=5432
# SPRING_DATA_REDIS_HOST=redis  # production: redis VPS's private IP
# SPRING_DATA_REDIS_PORT=6379
# EUREKA_URI=http://discovery-service:8761/eureka   # production: discovery-service VPS's private IP
# LDAP_URL=ldap://host.docker.internal:389
# MANAGEMENT_OTLP_TRACING_ENDPOINT=http://tempo:4318/v1/traces   # production: monitor VPS's private IP
# CMS_ADMIN_REDIRECT_URIS=http://localhost:5173/callback   # cms-platform's admin-app (Phase 4)
# CMS_ADMIN_POST_LOGOUT_REDIRECT_URIS=http://localhost:5173/login
