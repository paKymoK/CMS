# Copy to ".env" in this folder (gitignored) and uncomment/set only what needs to differ

# AUTH_ISSUER_URI=http://127.0.0.1:9000          # production: auth-service VPS's private IP
# EUREKA_URI=http://127.0.0.1:8761/eureka   # production: discovery-service VPS's private IP
# SPRING_DATA_REDIS_HOST=127.0.0.1  # production: redis VPS's private IP
# SPRING_DATA_REDIS_PORT=6379
# GATEWAY_IO_WORKER_COUNT=      # default: Reactor Netty's own default worker count
# SINGLE_TAB_REDIS_ON_FAILURE=FAIL_OPEN
